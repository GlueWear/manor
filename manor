#!/usr/bin/env bash
# manor: run Manor's front door, Caddy, next to the Theseus host.
#
#   ./manor check       validate ./Caddyfile
#   ./manor start       start Caddy in the background (logs/caddy.log)
#   ./manor stop
#   ./manor restart     e.g. after downloading a new Caddyfile
#   ./manor status
#   ./manor logs
#   ./manor install     a launchd agent (macOS): start at login, restart on failure
#   ./manor uninstall
#
# Everything else, handing out moons and resetting them, is the %manor app
# on the ship. Download the Caddyfile from its Front door section and save it
# next to this script as Caddyfile.
set -u
MANOR_HOME="$(cd "$(dirname "$0")" && pwd)"
CONFIG="$MANOR_HOME/Caddyfile"
LOGS="$MANOR_HOME/logs"
AGENTS="$HOME/Library/LaunchAgents"
GUI="gui/$(id -u)"
LABEL=io.gluewear.manor.caddy
MATCH="caddy run --config $CONFIG"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

log() { printf 'manor: %s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }

need_config() {
  command -v caddy >/dev/null || die "caddy not found (brew install caddy)"
  [ -f "$CONFIG" ] || die "no $CONFIG: download it from the Front door section of the Manor page"
  mkdir -p "$LOGS"
}

running() { pgrep -f "$MATCH" >/dev/null 2>&1; }
installed() { [ -f "$AGENTS/$LABEL.plist" ]; }

cmd_check() {
  need_config
  caddy validate --config "$CONFIG" --adapter caddyfile >/dev/null 2>&1 \
    || { caddy validate --config "$CONFIG" --adapter caddyfile 2>&1 | tail -5; die "the Caddyfile is not valid"; }
  echo "caddy   $CONFIG is valid"
  grep -E '^# (Router|Test):' "$CONFIG" | sed 's/^# /        /'
}

cmd_start() {
  if installed; then launchctl kickstart "$GUI/$LABEL"; cmd_status; return; fi
  need_config
  if running; then echo "caddy   already running"; return; fi
  nohup caddy run --config "$CONFIG" --adapter caddyfile >>"$LOGS/caddy.log" 2>&1 &
  echo "caddy   started (logs/caddy.log)"
}

cmd_stop() {
  installed && die "launchd keeps Caddy running; use ./manor uninstall to stop it for good"
  pkill -f "$MATCH" || { echo "caddy   not running"; return; }
  # Caddy lets open connections finish for up to 10 seconds
  local i
  for i in $(seq 1 15); do running || break; sleep 1; done
  echo "caddy   stopped"
}

cmd_restart() {
  if installed; then launchctl kickstart -k "$GUI/$LABEL"; echo "restarted"; return; fi
  cmd_stop
  cmd_start
}

cmd_status() {
  if running; then echo "caddy   running"; else echo "caddy   stopped"; fi
  if installed; then echo "launchd agent installed"; fi
}

cmd_logs() {
  mkdir -p "$LOGS"
  touch "$LOGS/caddy.log"
  tail -n 40 -f "$LOGS/caddy.log"
}

cmd_install() {
  need_config
  cmd_check >/dev/null   # fail here rather than in a restart loop
  mkdir -p "$AGENTS"
  launchctl bootout "$GUI/$LABEL" 2>/dev/null
  pkill -f "$MATCH" >/dev/null 2>&1
  cat >"$AGENTS/$LABEL.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$(command -v caddy)</string><string>run</string><string>--config</string><string>$CONFIG</string><string>--adapter</string><string>caddyfile</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$LOGS/caddy.log</string>
  <key>StandardErrorPath</key><string>$LOGS/caddy.log</string>
</dict></plist>
EOF
  launchctl bootstrap "$GUI" "$AGENTS/$LABEL.plist" || die "could not load $LABEL"
  echo "installed: Caddy starts at login and restarts on failure (logs/caddy.log)"
}

cmd_uninstall() {
  launchctl bootout "$GUI/$LABEL" 2>/dev/null
  rm -f "$AGENTS/$LABEL.plist"
  echo "removed $LABEL"
}

case "${1:-status}" in
  check) cmd_check ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
