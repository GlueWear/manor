# manor settings. Copy to manor.env (kept out of git) and fill in.

# The Theseus host ship and its pier. ./manor reads the host's public Eyre port
# from <pier>/.http.ports at every start, so a host restart on a new port only
# needs ./manor restart.
THESEUS_SHIP=~siglup-narwet
THESEUS_PIER=/path/to/ships/siglup-narwet

# The public name moons live under: join.<base> and <moon>.<base>.
# With nip.io this is your public IP with dashes, e.g. 203.0.113.7 ->
# 203-0-113-7.nip.io. Find it with: curl -s https://api.ipify.org
MANOR_BASE=203-0-113-7.nip.io

# Where a visitor lands on their moon.
MANOR_LANDING=/apps/noltbook/

# Ports. The router forwards public TCP 443 to this Mac's MANOR_HTTPS_PORT.
MANOR_HTTPS_PORT=8443
MANOR_LOCAL_PORT=8090
MANOR_BROKER_PORT=8091
# Caddy's admin API. The Theseus gateway's Caddy already uses localhost:2019.
MANOR_ADMIN=localhost:2020

# Let's Encrypt. For trial runs use the staging directory, which has no rate
# limits but whose certificates browsers do not trust:
#   https://acme-staging-v02.api.letsencrypt.org/directory
MANOR_ACME_DIR=https://acme-v02.api.letsencrypt.org/directory
